# Copy to .env.local and fill in. Firebase web config (Project settings > Your apps). Never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to true to use the local Firebase Auth emulator at http://127.0.0.1:9099.
NEXT_PUBLIC_USE_AUTH_EMULATOR=false

# Dev only (ignored in production builds): force a role to try the UI as viewer, member or admin.
# NEXT_PUBLIC_DEV_ROLE=
