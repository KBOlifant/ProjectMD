# Copy this file to backend/.env and fill in the values. backend/.env is ignored by git.
# Real environment variables override this file.

# PostgreSQL connection string (Npgsql format).
ConnectionStrings__Default=Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

# Emails that become admin when they sign in with a verified email (add more with __1, __2 ...).
Auth__AdminEmails__0=you@example.com

# Scanner mode: static | extract | ai  (ai = real fetch plus one Groq call for the prose)
Scanner__Mode=ai
# Use an installed browser instead of Playwright's Chromium: chrome | msedge (leave empty to use Playwright's)
Scanner__BrowserChannel=chrome

# Groq API key (server-side only, never commit it). With an empty key, ai mode falls back to the basic document.
Ai__ApiKey=YOUR_GROQ_API_KEY
# Model used for everything (required when a key is set).
Ai__FastModel=openai/gpt-oss-20b
# Optional: Ai__ReasoningEffort=low | medium | high   (default low)
# Optional: Ai__ReasoningTokenHeadroom=400   Ai__TimeoutSeconds=30   Ai__BaseUrl=https://api.groq.com/openai/v1
